<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The plugin writes /sdcard/MobileGL/runtime.conf, which the launcher's game process
         reads when it loads libMobileGL.so. All-files access is optional: without it the UI
         falls back to a private copy and says so. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:hasCode="true"
        android:enableOnBackInvokedCallback="true"
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MobileGLPlugin">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:label="${appLabel}"
            android:theme="@style/Theme.MobileGLPlugin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PostActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:theme="@style/Theme.MobileGLPlugin" />

        <activity
            android:name=".PluginActivity"
            android:exported="true"
            android:theme="@style/Theme.MobileGLPlugin.NoDisplay" />

        <!-- Zalith Launcher / RendererPlugin-v2 configuration -->
        <meta-data
            android:name="fclPlugin_V2"
            android:resource="@string/config" />
        <meta-data
            android:name="mobilegl_backend_type_title"
            android:resource="@string/mobilegl_backend_type_title" />
        <meta-data
            android:name="mobilegl_disable_timerquery_title"
            android:resource="@string/mobilegl_disable_timerquery_title" />
        <meta-data
            android:name="mobilegl_disable_subgroup_title"
            android:resource="@string/mobilegl_disable_subgroup_title" />
        <meta-data
            android:name="mobilegl_r11g11b10f_fallback_title"
            android:resource="@string/mobilegl_r11g11b10f_fallback_title" />
        <meta-data
            android:name="sfpew_backend_title"
            android:resource="@string/sfpew_backend_title" />
        <meta-data
            android:name="sfpew_relaxed_context_title"
            android:resource="@string/sfpew_relaxed_context_title" />
        <meta-data
            android:name="sfpew_no_multidrawarrays_title"
            android:resource="@string/sfpew_no_multidrawarrays_title" />
        <meta-data
            android:name="sfpew_no_list_batch_title"
            android:resource="@string/sfpew_no_list_batch_title" />

        <!-- Legacy FCL / Pojav plugin descriptor (kept for compatibility) -->
        <meta-data
            android:name="fclPlugin"
            android:value="true" />
        <meta-data
            android:name="des"
            android:value="${des}" />
        <meta-data
            android:name="renderer"
            android:value="${renderer}" />
        <meta-data
            android:name="boatEnv"
            android:value="${boatEnv}" />
        <meta-data
            android:name="pojavEnv"
            android:value="${pojavEnv}" />
        <meta-data
            android:name="minMCVer"
            android:value="${minMCVer}" />
        <meta-data
            android:name="maxMCVer"
            android:value="${maxMCVer}" />
    </application>

</manifest>